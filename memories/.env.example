# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_this_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret
CLIENT_URL=http://localhost:5173
COOKIE_SECURE=false

# Required for uploads (https://cloudinary.com, free tier works)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: email for verification + password reset (links print to `docker compose logs backend` if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Couple Memories <no-reply@example.com>"
